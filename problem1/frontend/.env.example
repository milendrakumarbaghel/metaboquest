# connected (default) or standalone. A failed connection never changes mode.
VITE_APP_MODE=connected
# Local dev/preview: leave blank to send /api through the Vite proxy.
# Production (Vercel): set to the Railway backend origin, without /api.
VITE_API_BASE_URL=
# Used only by Vite dev/preview, not by deployed static hosting.
API_PROXY_TARGET=http://localhost:8080
# Where the "See if the programme fits you" / "Talk to a Steer doctor" buttons open.
# Default is Steer's public website (checked: HTTP 200). The app opens only the
# origin + path: no query string, no topic, no score, no personal data is appended.
# Sharing a topic with Steer would need explicit consent and a real handoff mechanism.
VITE_STEER_URL=https://steerclub.com
