# Required: use different random values in every environment.
PIPELINE_API_KEY=replace-with-a-long-random-ingestion-key
REVIEW_API_KEY=replace-with-a-different-long-random-review-key

# Optional. With no AI_API_KEY, a grounded English-only extractive engine is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Database variables are already referenced by application.properties.
# Do not commit real values.
DB_URL=jdbc:postgresql://localhost:5432/metaboquest_content
DB_USERNAME=postgres
DB_PASSWORD=replace-me
